---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import { siteContent } from "../../lib/content";
import { PROJECT_TAGS } from "../../lib/tags";
import type { ProjectTag } from "../../lib/tags";

/**
 * The home page, filtered. One prerendered page per category, so a filtered
 * list is a real URL that can be shared, bookmarked and crawled — and so the
 * filter menu keeps working with JavaScript off.
 */
export function getStaticPaths() {
  return PROJECT_TAGS.map((tag) => ({ params: { tag: tag.value }, props: { tag } }));
}

const { tag } = Astro.props as { tag: ProjectTag };
---

<BaseLayout
  title={`${tag.headline} — ${siteContent.name}`}
  description={`${tag.headline} by 100k Studio: ${tag.description}. Web development and design from Berlin.`}
  bodyType="frontpage"
  path={`/tag/${tag.value}/`}
>
  <SiteShell activeTag={tag.value} />
</BaseLayout>
