---
import BaseLayout from "./BaseLayout.astro";
import { siteContent } from "../lib/content";
import ArrowRight from "../components/ArrowRight.astro";

interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
}

const { title, heading, description, path } = Astro.props;
---

{/* `noindex, follow` rather than a block: there is nothing here worth ranking,
    but the links out of it should still carry. `standalone` keeps the legacy
    application — and the 152 KB of project data it needs — off a text page. */}
<BaseLayout
  title={`${title} — ${siteContent.name}`}
  description={description}
  bodyType="frontpage"
  path={path}
  noindex
  standalone
>
  <main class="legal-page">
    <a class="legal-page__back _bigtext" href="/"><ArrowRight />Back to 100k Studio</a>
    <h1 class="_bigtext4">{heading}</h1>
    <div class="legal-page__body">
      <slot />
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Scoped to this page type, so nothing here can reach the site shell. The
     type classes are the site's own — only the page frame is new. */
  body:has(.legal-page) {
    background: #fff;
    overflow: auto;
  }

  .legal-page {
    box-sizing: border-box;
    margin: 0 auto;
    max-width: 820px;
    padding: 40px 20px 120px;
  }

  .legal-page__back {
    align-items: center;
    display: inline-flex;
    gap: 8px;
    margin-bottom: 60px;
    text-decoration: none;
  }

  .legal-page__back svg {
    height: 0.72em;
    width: auto;
  }

  .legal-page h1 {
    margin-bottom: 48px;
  }

  .legal-page__body h2 {
    font-family: "Rethink Sans", Arial, Helvetica, sans-serif;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    margin: 48px 0 16px;
  }

  .legal-page__body h3 {
    font-family: "Rethink Sans", Arial, Helvetica, sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    margin: 32px 0 12px;
  }

  .legal-page__body p,
  .legal-page__body li {
    font-family: "Rethink Sans", Arial, Helvetica, sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
    margin: 0 0 16px;
  }

  .legal-page__body ul {
    margin: 0 0 16px;
    padding-left: 24px;
  }

  .legal-page__body a {
    color: #000;
    text-underline-offset: 3px;
  }

  .legal-page__draft {
    background: #f2f2f2;
    border-left: 3px solid #000;
    margin: 0 0 48px;
    padding: 20px 24px;
  }

  .legal-page__draft p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .legal-page {
      padding: 20px 20px 80px;
    }

    .legal-page h1 {
      font-size: 40px;
      margin-bottom: 32px;
    }

    .legal-page__back {
      margin-bottom: 40px;
    }

    .legal-page__body h2 {
      font-size: 24px;
    }

    .legal-page__body p,
    .legal-page__body li {
      font-size: 17px;
    }
  }
</style>
