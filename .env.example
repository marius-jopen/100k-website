# --- Images: Bunny CDN pull zone -------------------------------------------
# Pull zone that fronts the image tree. Leave empty to serve images from the
# local public/media folder instead (useful when working offline).
PUBLIC_IMAGE_CDN_URL=https://100k-website.b-cdn.net

# Path the pull zone origin serves the media tree from.
#   /wp-content/uploads  → while http://100k.studio is still the WordPress site
#   /media               → once this site is deployed as the origin
PUBLIC_IMAGE_CDN_PREFIX=/wp-content/uploads

# --- Videos: Bunny Stream ---------------------------------------------------
# CDN hostname of the Bunny Stream video library (library 723058).
PUBLIC_BUNNY_STREAM_HOST=vz-a22b3102-67f.b-cdn.net

# Only needed by `npm run sync:bunny`, never shipped to the browser.
BUNNY_STREAM_LIBRARY_ID=723058
BUNNY_STREAM_API_KEY=

# --- Contact form -----------------------------------------------------------
# The form posts straight to Static Forms, the way their own snippet does, and
# carries this key in the page. It is meant to be public — their setup puts it
# in a hidden input — and the alternative cost us delivery: posted from a
# server, submissions arrive from a datacenter address and are filed as spam.
# Baked in at build time, so set it in the Vercel project too.
PUBLIC_STATIC_FORM_API_KEY=
