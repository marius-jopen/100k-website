---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArrowRight from "../../../components/ArrowRight.astro";
import { BAU_DEMOS, type BauDemo } from "../../../lib/bau-demos";

/*
 * One complete demo website per trade.
 *
 * These are what the construction landing page sells: a visitor should be
 * able to scroll one, click through the request form and apply for a job, and
 * come away knowing what they would get. The four share a skeleton — start,
 * services, references, request, careers, contact — and nothing else: each
 * trade has its own palette, its own hero and its own way of listing things,
 * set by `data-trade` in `bau-demo.css`.
 *
 * Every name and number here is invented; the footer says so.
 */

export function getStaticPaths() {
  return BAU_DEMOS.map((demo) => ({ params: { trade: demo.value }, props: { demo } }));
}

const { demo } = Astro.props as { demo: BauDemo };
const path = `/bau/demo/${demo.value}/`;
const [heroPair] = demo.references.filter((reference) => reference.before);
const numbered = demo.value === "rohbau" || demo.value === "sanierung";
---

<BaseLayout
  title={`${demo.firm} — Demo-Website von 100k Studio`}
  description={demo.sub}
  bodyType="frontpage"
  path={path}
  noindex
  standalone
  legacyStyles={false}
  lang="de"
  locale="de_DE"
  stylesheets={["/assets/bau-demo.css"]}
>
  <div class="demo" data-trade={demo.value}>
    {/* Only when opened on its own; inside the landing page's frame the script
        hides it, because there the page around it already says what this is. */}
    <div class="demo-banner">
      <span>Demo-Website von 100k Studio. Alle Namen und Zahlen sind erfunden.</span>
      <a href="/bau/">Zurück zu 100k Studio</a>
    </div>

    <header class="demo-header">
      <a class="demo-brand" href="#start">{demo.firm}</a>
      <nav class="demo-nav" aria-label="Seitenbereiche">
        <a href="#leistungen">Leistungen</a>
        <a href="#referenzen">Referenzen</a>
        <a href="#karriere">Karriere</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="demo-phone" href={`tel:${demo.phone.replace(/\s/g, "")}`}>{demo.phone}</a>
      <a class="demo-btn demo-btn--primary" href="#anfrage">{demo.cta}</a>
    </header>

    <main>
      {/* ---------------------------------------------------------------- Start */}
      <section class="demo-hero" id="start">
        <div class="demo-hero__media">
          {heroPair ? (
            <div class="demo-pair" data-pair>
              <img src={heroPair.before} alt="" />
              <img src={heroPair.image} alt="" class="is-after" />
              <div class="demo-pair__switch" role="tablist" aria-label="Vorher oder Nachher">
                <button type="button" role="tab" aria-selected="false" data-pair-state="before">Vorher</button>
                <button type="button" role="tab" aria-selected="true" data-pair-state="after">Nachher</button>
              </div>
            </div>
          ) : (
            <img src={demo.hero} alt="" />
          )}
        </div>
        <div class="demo-hero__copy">
          {/* Two sentences, two lines: the claim is written to break at the full stop. */}
          <h1 set:html={demo.claim.replace(/\. /, ".<br />")}></h1>
          <p>{demo.sub}</p>
          <div class="demo-hero__actions">
            <a class="demo-btn demo-btn--primary" href="#anfrage"><ArrowRight />{demo.cta}</a>
            <a class="demo-btn" href="#referenzen">Referenzen</a>
          </div>
        </div>
        <ul class="demo-facts">
          {demo.facts.map(([big, small]) => (
            <li><b>{big}</b><span>{small}</span></li>
          ))}
        </ul>
      </section>

      {/* ------------------------------------------------------------ Services */}
      <section class="demo-section" id="leistungen">
        <div class="demo-section__head">
          <h2>Leistungen</h2>
          <p>Drei Dinge, die wir jeden Tag machen. Alles andere sagen wir Ihnen ehrlich am Telefon.</p>
        </div>
        <ol class:list={["demo-services", { "demo-services--rows": numbered }]}>
          {demo.services.map((service, index) => (
            <li>
              <span class="demo-services__no">{String(index + 1).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </li>
          ))}
        </ol>
      </section>

      {/* ---------------------------------------------------------- References */}
      <section class="demo-section" id="referenzen">
        <div class="demo-section__head">
          <h2>Referenzen</h2>
          <p>Mit Ort, Umfang und Dauer. Damit Sie einschätzen können, ob Ihr Projekt zu uns passt.</p>
        </div>
        <div class="demo-refs">
          {demo.references.map((reference) => (
            <article class="demo-ref">
              {reference.before ? (
                <div class="demo-pair demo-ref__media" data-pair>
                  <img src={reference.before} alt="" loading="lazy" />
                  <img src={reference.image} alt="" class="is-after" loading="lazy" />
                  <div class="demo-pair__switch" role="tablist" aria-label="Vorher oder Nachher">
                    <button type="button" role="tab" aria-selected="false" data-pair-state="before">Vorher</button>
                    <button type="button" role="tab" aria-selected="true" data-pair-state="after">Nachher</button>
                  </div>
                </div>
              ) : (
                <div class="demo-ref__media"><img src={reference.image} alt="" loading="lazy" /></div>
              )}
              <h3>{reference.title}</h3>
              <p>{reference.place} · {reference.scope}</p>
            </article>
          ))}
        </div>
      </section>

      {/* ------------------------------------------------------------- Request */}
      <section class="demo-section demo-request" id="anfrage">
        <div class="demo-section__head">
          <h2>{demo.cta}</h2>
          <p>Vier Fragen, dann haben wir alles für ein erstes Angebot. Kein Anruf, kein Formular mit zwanzig Feldern.</p>
        </div>
        <div class="demo-wizard" data-wizard>
          <div class="demo-wizard__dots" data-dots aria-hidden="true"></div>
          <div class="demo-wizard__step" data-step="0">
            <h3>Was soll gemacht werden?</h3>
            <div class="demo-chips" data-field="art">
              {demo.requestOptions.map((option) => <button type="button" class="demo-chip">{option}</button>)}
            </div>
          </div>
          <div class="demo-wizard__step" data-step="1" hidden>
            <h3>Um welches Objekt geht es?</h3>
            <div class="demo-chips" data-field="objekt">
              {demo.objectOptions.map((option) => <button type="button" class="demo-chip">{option}</button>)}
            </div>
          </div>
          <div class="demo-wizard__step" data-step="2" hidden>
            <h3>Wann soll es losgehen?</h3>
            <div class="demo-chips" data-field="wann">
              <button type="button" class="demo-chip">So bald wie möglich</button>
              <button type="button" class="demo-chip">In 1–3 Monaten</button>
              <button type="button" class="demo-chip">Noch in Planung</button>
            </div>
          </div>
          <div class="demo-wizard__step" data-step="3" hidden>
            <h3>Wie erreichen wir Sie?</h3>
            <div class="demo-wizard__fields">
              <input type="text" placeholder="PLZ oder Ort" data-field="ort" aria-label="Ort" />
              <input type="tel" placeholder="Telefonnummer" data-field="telefon" aria-label="Telefonnummer" />
            </div>
            <button type="button" class="demo-btn demo-btn--primary" data-send><ArrowRight />Anfrage senden</button>
          </div>
          <div class="demo-wizard__step demo-wizard__done" data-step="4" hidden>
            <h3>Danke. Wir melden uns bis morgen 10 Uhr.</h3>
            <dl data-summary></dl>
            <p class="demo-wizard__note">Demo: Es wurde nichts gesendet.</p>
            <button type="button" class="demo-btn" data-restart>Noch einmal</button>
          </div>
          <button type="button" class="demo-wizard__back" data-back hidden>Zurück</button>
        </div>
      </section>

      {/* ------------------------------------------------------------- Careers */}
      <section class="demo-section demo-careers" id="karriere">
        <div class="demo-careers__media"><img src="/images/bau/team.jpg" alt="" loading="lazy" /></div>
        <div class="demo-careers__copy">
          <h2>Wir suchen Leute, die anpacken.</h2>
          <p>Bewerben Sie sich in 60 Sekunden. Kein Anschreiben, kein Lebenslauf. Wir rufen Sie an.</p>
          <div class="demo-apply" data-apply>
            <div class="demo-chips" data-field="beruf">
              {demo.jobs.map((job) => <button type="button" class="demo-chip">{job}</button>)}
            </div>
            <div class="demo-apply__row">
              <input type="tel" placeholder="Ihre Telefonnummer" data-field="telefon" aria-label="Telefonnummer" />
              <button type="button" class="demo-btn demo-btn--primary" data-apply-send>Rückruf</button>
            </div>
            <p class="demo-apply__done" hidden>Danke. Wir rufen Sie werktags bis 18 Uhr an. <small>Demo: nichts gesendet.</small></p>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------------- Contact */}
      <section class="demo-section demo-contact" id="kontakt">
        <div>
          <h2>{demo.firm}</h2>
          <p>Musterstraße 1<br />{demo.city}</p>
        </div>
        <div>
          <h3>Erreichbar</h3>
          <p>Mo–Fr 6–18 Uhr<br /><a href={`tel:${demo.phone.replace(/\s/g, "")}`}>{demo.phone}</a><br /><a href={`mailto:info@${demo.domain}`}>info@{demo.domain}</a></p>
        </div>
        <div>
          <h3>Einsatzgebiet</h3>
          <p>{demo.city} und 50 km Umkreis. Für größere Projekte auch darüber hinaus.</p>
        </div>
      </section>
    </main>

    <footer class="demo-footer">
      <span>© {new Date().getFullYear()} {demo.firm} · Impressum · Datenschutz</span>
      <span>Demo-Website von <a href="/bau/">100k Studio</a>. Namen, Zahlen und Referenzen sind erfunden.</span>
    </footer>
  </div>

  <script is:inline src="/assets/bau-demo.js"></script>
</BaseLayout>
